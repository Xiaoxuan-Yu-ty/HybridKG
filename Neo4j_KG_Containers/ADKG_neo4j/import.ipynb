   "source": [
    "with open(kg_path, 'rb') as f:\n",
    "    KG = pickle.load(f)\n",
    "\n",
    "# 1. Convert Nodes\n",
    "nodes_data = []\n",
    "for node_id, attrs in KG.nodes(data=True):\n",
    "    #print(attrs)\n",
    "    node_dict = {\":ID\": node_id}\n",
    "    \n",
    "    if \"label\" in attrs:\n",
    "        node_dict[\":LABEL\"] = attrs.pop(\"label\")\n",
    "    node_dict[\"bel\"] = node_id\n",
    "    node_dict['bel'] = node_id\n",
    "    if \"name\" not in attrs:\n",
    "        node_dict['name'] = node_id\n",
    "    # Add all remaining attributes as Neo4j properties\n",
    "    node_dict.update(attrs)\n",
    "    nodes_data.append(node_dict)\n",
    "\n",
    "df_nodes = pd.DataFrame(nodes_data)\n",
    "df_nodes.to_csv(\"./import/nodes.csv\", index=False)\n",
    "df_nodes"
   ]
  },
