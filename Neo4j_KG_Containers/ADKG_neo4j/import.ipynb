    "# 2. extract and format edges\n",
    "edges_data = []\n",
    "for source, target, rel, attrs in KG.edges(data=True, keys=True):\n",
    "    # print(source, rel, target)\n",
    "    # print(attrs)\n",
    "    # break\n",
    "    edge_dict = {\n",
    "        \":START_ID\": source,\n",
    "        \":END_ID\": target,\n",
    "        \":TYPE\": rel,\n",
    "    }\n",
    "         \n",
    "    # Add all remaining attributes as edge properties\n",
    "    edge_dict.update(attrs)\n",
    "    edges_data.append(edge_dict)\n",
    "\n",
    "df_edges = pd.DataFrame(edges_data)\n",
    "df_edges.to_csv(\"./import/edges.csv\", index=False)\n",
    "\n",
    "print(\"Export complete! Files saved as 'nodes.csv' and 'edges.csv'.\")\n",
    "df_edges"
   ]
